{
  "name": "pizzahub-server",
  "version": "1.0.0",
  "description": "PizzaHub REST API: Express 5, TypeScript, MongoDB (Mongoose), Stripe webhooks",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "start": "tsx src/local.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed/seed.ts",
    "make-admin": "tsx src/seed/make-admin.ts"
  },
  "author": "Amena Begum",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jose": "^6.2.18",
    "mongoose": "^9.12.3",
    "nodemailer": "^10.6.1",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "better-auth": "^1.7.27",
