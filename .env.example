# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB (same database the Better Auth client uses)
MONGODB_URI=
DB_NAME=pizzahub

# Shared with the Next.js client: it signs short-lived API tokens, this server verifies them
JWT_SECRET=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Optional: order email notifications (any SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SUPPORT_EMAIL=
# Seeded demo accounts on these domains never receive emails
DEMO_EMAIL_DOMAINS=pizzahub.app,example.com
